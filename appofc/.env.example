# Copy to .env for local development (never commit .env)

# development | production | test
NODE_ENV=development

# Backend HTTP port
PORT=3000

# Local Postgres (docker compose up -d)
DATABASE_URL=postgresql://autodisplay:autodisplay_dev@localhost:5432/autodisplay

# Integration tests only — never point destructive tests at the dev database
# DATABASE_URL=postgresql://autodisplay:autodisplay_dev@localhost:5432/autodisplay_test

# Vite dev server origin (CORS allowlist in development)
FRONTEND_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional — app starts normally when omitted
# SENTRY_DSN=https://example@sentry.io/project

# Optional — run `bun run prisma:seed` only when both values are set
# SEED_EMPRESA_RAZAO_SOCIAL=AutoDisplay Ltda
# SEED_EMPRESA_NOME_FANTASIA=AutoDisplay
# SEED_EMPRESA_CNPJ=00000000000000

# Auth — use UUID from seeded Empresa; secret >= 32 chars (generate for production)
AUTH_EMPRESA_ID=00000000-0000-4000-8000-000000000001
AUTH_CSRF_SECRET=local-dev-csrf-secret-min-32-chars!!
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=12
AUTH_MAX_SESSIONS_PER_USER=3
